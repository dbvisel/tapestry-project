# Sample environment for the Tapestry MinIO stack.
#
# This file is committed to the repository and MUST NOT contain real secrets.
# It holds the non-secret defaults; every secret/credential below is left blank
# and is filled in by the installer (./setup.sh) — generated for passwords and
# internal credentials, or prompted for things like Sentry DSNs and IA creds.
#
# Do not edit your live config here. Run ./setup.sh, which copies this file to
# .env (git-ignored) and fills in the rest.

HOST=localhost

# --- public URLs (derived from HOST by setup.sh) ---

# VIEWER_URL=https://tapestries.archive.org
VIEWER_URL=http://localhost:8080
# EXTERNAL_SERVER_URL=https://tapestries-api.archive.org
EXTERNAL_SERVER_URL=http://localhost:3000

# --- client ---
#
# Only VITE_API_URL is read directly. The rest of the client's build-time
# config is taken from the non-VITE_ keys below: docker-compose.minio.yml maps
# them into the client's VITE_* build args (e.g. VITE_AUTH_PROVIDER from
# AUTH_PROVIDER, VITE_SENTRY_DSN from SENTRY_DSN_CLIENT). So there's no need to
# duplicate them with a VITE_ prefix here.

# VITE_API_URL=https://tapestries-api.archive.org/api
VITE_API_URL=http://localhost:3000/api

AUTH_PROVIDER=ia
BUG_REPORT_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeUKYyfCund4xOECGbJuI8rat8fzL1-Qjp4pzgYkxK95AwusQ/viewform?usp=pp_url&entry.222002216=:browserName&entry.1351984793=:browserVersion&entry.2107745582=:operatingSystem&entry.412753743=:tapestryInformation
AI_CHAT_EXPIRES_IN=3600
WEBPAGE_LOADER_TIMEOUT=3
STUN_SERVER=stun:stun.l.google.com:19302
# secret: prompted by setup.sh
SENTRY_DSN_CLIENT=

# --- shared ---

GOOGLE_CLIENT_ID=

# --- db (DB_PASS generated by setup.sh) ---

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tapestries
DB_USER=tapestries
DB_PASS=
DB_LOG_LEVEL=query,info,warn,error
DB_USE_SSL=
DATABASE_URL='postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public'

# --- redis ---

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USE_TLS=true

# --- minio / aws (AWS_SECRET_ACCESS_KEY + MINIO_CONSOLE_SECRET_KEY generated by setup.sh) ---

AWS_ACCESS_KEY_ID=tapestries
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tabucket
AWS_S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_ACCESS_KEY=tapestries
MINIO_CONSOLE_SECRET_KEY=
AWS_ENDPOINT_URL=http://localhost:9000
# Endpoint the server/worker containers use to reach MinIO directly (Compose network name,
# not the published port the browser uses). Leave blank for real AWS S3.
AWS_INTERNAL_ENDPOINT_URL=http://minio:9000

# --- server / worker / vault (SECRET_KEY + VAULT_ROLE_ID + VAULT_SECRET_ID generated by setup.sh) ---

SECRET_KEY=
JOBS_ADMIN_NAME=
JOBS_ADMIN_PASSWORD=
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# secret: prompted by setup.sh
SENTRY_DSN_SERVER=

# --- vault (KMS auto-unseal; unused in the local dev vault) ---

VAULT_KMS_KEY_ARN=
VAULT_AWS_REGION=us-east-1
VAULT_AWS_ACCESS_KEY_ID=tapestries
VAULT_AWS_SECRET_ACCESS_KEY=

# --- IA auth (prompted by setup.sh; leave blank unless using *.archive.org shared sessions) ---

IA_ACCOUNT_ID=
IA_SECRET=

# --- worker ---

PUPPETEER_ARGS='--no-sandbox,--disable-gpu,--disable-dev-shm-usage'
S3_CLEAN_UP_CRON_PATTERN='0 0 * * *'
TAPESTRY_THUMBNAIL_GENERATION_DELAY=120_000
TAPESTRY_THUMBNAIL_GENERATION_TIMEOUT=600_000
ITEM_THUMBNAIL_GENERATION_DELAY=120_000
