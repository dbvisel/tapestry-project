# Base URL of the Tapestry API (note: includes the "/api" prefix).
TAPESTRY_API_URL=http://localhost:3000/api

# Used only to build human-viewable "https://.../u/<username>/<slug>" links in tool responses.
TAPESTRY_VIEWER_URL=http://localhost:8080

# Internet Archive account credentials. This is a proof of concept: Tapestry has no personal-access-token
# concept for third-party clients today, so this server logs in with a real IA username/password (the only
# non-interactive login path available) and manages the resulting short-lived session itself. Treat these
# credentials with the same care as the account's real password - there is no scoped, revocable token here.
TAPESTRY_IA_EMAIL=
TAPESTRY_IA_PASSWORD=
